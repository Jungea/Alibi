# 환경변수 예시 파일입니다. 실제 값은 .env.local에 넣고, 이 파일에는 키 이름만 둡니다.

# --- Supabase (R2~) ---
# Supabase 대시보드 > Project Settings > API 에서 확인합니다.
NEXT_PUBLIC_SUPABASE_URL=
# anon(공개) 키 또는 publishable 키. 브라우저에 노출되어도 되는 값이며, 보안은 RLS가 담당합니다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 선택: 이메일 확인 링크가 돌아올 주소. 비우면 요청 주소를 그대로 씁니다.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# service_role 키는 이 앱 코드에서 사용하지 않습니다. 브라우저에 노출되면 안 되며, 필요해도 서버 전용으로만 쓰고 커밋하지 않습니다.
